<Window x:Class="Project_Menedger.InformationDocuments"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
        Title="Информация о документах" Height="800" Width="1200" WindowStartupLocation="CenterScreen" 
Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="800" MinWidth="1200"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.16*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.30*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="0" Grid.Column="0" MaxHeight="100">
            <Grid>
                <TextBlock Width="115" Height="20" TextAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="70" Height="20" Background="#63a4ff" Content="Назад" FontSize="9" FontStyle="Italic"
                            x:Name="Button_Back" Foreground="#fff" HorizontalAlignment="Left"
                            Click="Button_Back_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </TextBlock>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Документация" FontSize="10" Foreground="White"
                       FontStyle="Italic" FontWeight="Black" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top"
         Grid.Column="1">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
                <Button Content="🗕" FontFamily="Comic Sans MS" Height="15" Width="15"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 41 0"
FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
VerticalContentAlignment="Center" x:Name="Button_RollUp" Click="Button_RollUp_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationEmployee" Visibility="Hidden">

        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationAdministrator" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" Content="Добавить" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left">
                            <TextBlock Text="Редактировать" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="2" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left">
                            <TextBlock Text="Удалить" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationManager" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" Content="Добавить" FontSize="9" FontStyle="Italic"
                        Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_AddDocuments" Click="Button_AddDocuments_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_RedactDocuments" Click="Button_RedactDocuments_Click">
                            <TextBlock Text="Редактировать" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="2" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_DeleteDocuments" Click="Button_DeleteDocuments_Click">
                            <TextBlock Text="Удалить" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" Content="Сбросить фильтрацию" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_ClearFilter" Click="Button_ClearFilter_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MaxHeight="110">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" >
                    <Grid>
                        <Label Content="Поиск" FontSize="16" Height="30" Width="90" Foreground="White" 
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               FontStyle="Italic"/>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="1" >
                <Grid>
                    <Label Content="Статус" FontSize="16" Height="30" Width="90" Foreground="White" 
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               FontStyle="Italic"/>
                </Grid>
                </Viewbox>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.1*"/>
                <RowDefinition Height="0.12*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" MaxHeight="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <Grid>
                        <TextBlock Width="120" Height="20" TextAlignment="Center" VerticalAlignment="Center">
                            <TextBox Height="15" Width="90" Foreground="Black" HorizontalContentAlignment="Center"
                            BorderBrush="White" FontSize="9" VerticalContentAlignment="Center" x:Name="TextBox_Search"
                                      VerticalAlignment="Center" Margin="0 2 0 0" TextChanged="TextBox_Search_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        </TextBlock>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <Grid>
                        <TextBlock Width="120" Height="20" TextAlignment="Center" VerticalAlignment="Center">
                        <ComboBox Height="15" Width="90" FontSize="7" HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Margin="0 2 0 0" DisplayMemberPath="Namee" SelectedValuePath="Namee"
                                  SelectionChanged="ComboBox_SelectionChanged" x:Name="ComboBox_Status">
                        </ComboBox>
                        </TextBlock>
                    </Grid>
                </Viewbox>
            </Grid>
            <Viewbox Grid.Row="2" Grid.ColumnSpan="3" Margin="5" Visibility="Visible"
                     x:Name="DocumentsVisibility" Stretch="Fill">
                <ListView Grid.Row="2" Grid.ColumnSpan="3" Margin="5" x:Name="ListView_Documents"
                          Height="500" Width="900">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="Black">
                                <Grid Width="865">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Проект:" Margin="10 7 0 0" FontSize="18"/>
                                            <TextBlock Text="{Binding Production_Project.Namee}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Прогресс:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Progress}" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="%" FontSize="18" Margin="3 7 0 0"/>
                                            <TextBlock Text="Статус:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Statuss.Namee}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Затраты:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Cost, StringFormat=0.00}" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="рублей" FontSize="18" Margin="10 5 0 7"/>
                                            <TextBlock Text="Прибыль:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Profit, StringFormat=0.00}" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="рублей" FontSize="18" Margin="10 5 0 7"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
