<Window x:Class="Project_Menedger.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
        Title="Регистрация" Height="700" Width="900" WindowStartupLocation="CenterScreen" 
        Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="700" MinWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Добавление пользователя" FontSize="14" Foreground="White"
                       FontStyle="Italic" FontWeight="Black" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="80" Height="45" HorizontalAlignment="Right"
                 VerticalAlignment="Top">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
                        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                        x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
                        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                        x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
                <Button Content="🗕" FontFamily="Comic Sans MS" Height="15" Width="15"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 41 0"
                        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                        VerticalContentAlignment="Center" x:Name="Button_RollUp"
                        Click="Button_RollUp_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 40 0"
                    VerticalAlignment="Center">
                <Label Content="Имя:" FontSize="12" Height="30" Width="80" Foreground="White" 
                   HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
                   />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
                     BorderBrush="White" x:Name="TextBox_Name"
                         FontStyle="Italic">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 40 0"
            VerticalAlignment="Center">
                <Label Content="Фамилия:" FontSize="12" Height="30" Width="80" Foreground="White" 
           HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
           />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
             BorderBrush="White" x:Name="TextBox_Surname" FontStyle="Italic">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 40 0"
            VerticalAlignment="Center">
                <Label Content="Отчество:" FontSize="12" Height="30" Width="80" Foreground="White" 
           HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
           />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
             BorderBrush="White" x:Name="TextBox_Patronomyc" FontStyle="Italic">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 40 0"
            VerticalAlignment="Center">
                <Label Content="Email:" FontSize="12" Height="30" Width="80" Foreground="White" 
           HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
           />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
             BorderBrush="White" x:Name="TextBox_Email" GotFocus="TextBox_Email_GotFocus" LostFocus="TextBox_Email_LostFocus"
                         TextChanged="TextBox_Email_TextChanged" FontStyle="Italic">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Popup x:Name="emailPoput" PlacementTarget="{Binding ElementName=TextBox_Email}"
                        Placement="Top" IsOpen="False" Width="115" Height="15">
                    <Border Background="#90004455" CornerRadius="5" Padding="4">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Формат email: Paha74@mail.ru</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Red" x:Name="checkEmail">Не выполнено</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 80 0"
            VerticalAlignment="Center">
                <Label Content="Номер телефона:" FontSize="12" Height="30" Width="120" Foreground="White" 
           HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
           />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
             BorderBrush="White" x:Name="TextBox_NumberPhone" GotFocus="TextBox_NumberPhone_GotFocus"
                         LostFocus="TextBox_NumberPhone_LostFocus" FontStyle="Italic" TextChanged="TextBox_NumberPhone_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <Popup x:Name="numberPhonePoput" PlacementTarget="{Binding ElementName=TextBox_NumberPhone}"
        Placement="Top" IsOpen="False" Width="128" Height="15">
                    <Border Background="#90004455" CornerRadius="5" Padding="4">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Формат телефона: +7(555)353-24-24</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Red" x:Name="checkNumberPhone">Не выполнено</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="6">
            <Grid>
                <Label Content="Пароль:" FontSize="12" Height="30" Width="80" Foreground="White" 
                   HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                   FontStyle="Italic" Margin="-160 0 0 0"/>
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center" x:Name="TextBox_Password"
                     Margin="40 0 0 0" BorderBrush="White" GotFocus="TextBox_Password_GotFocus" LostFocus="TextBox_Password_LostFocus"
                         TextChanged="TextBox_Password_TextChanged" FontStyle="Italic">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                    
                </TextBox>
                <Popup x:Name="passwordPopup" PlacementTarget="{Binding ElementName=TextBox_Password}"
               Placement="Top" IsOpen="False" Width="110" Height="40">
                    <Border Background="#90004455" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Пароль должен содержать:</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Не меньше 8 символов</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Red" x:Name="CheckSymbol8">Не выполнено</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Не больше 16 символов</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Green" x:Name="CheckSymbol16">Выполнено</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Минимум 1 заглавную букву</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Red" x:Name="CheckBukva1">Не выполнено</TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="5" Foreground="White">Минимум 1 цифру</TextBlock>
                                <TextBlock Margin="3 0 0 0" FontSize="5" Foreground="Red" x:Name="CheckCifra1">Не выполнено</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <PasswordBox Height="22" Width="124" HorizontalAlignment="Center" VerticalAlignment="Center" 
                         VerticalContentAlignment="Center" x:Name="PasswordBox_Password" HorizontalContentAlignment="Center"
                         Margin="40 0 0 0" GotFocus="PasswordBox_Password_GotFocus" LostFocus="PasswordBox_Password_LostFocus"
                              PasswordChanged="PasswordBox_Password_PasswordChanged" FontStyle="Italic">
                    <PasswordBox.Resources>
                        <Style TargetType="{x:Type PasswordBox}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                                        <Border CornerRadius="13" BorderThickness="2" Background="White">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>
                <CheckBox Height="15" Margin="180 0 0 0" x:Name="CheckBox_Password"
                      Click="CheckBox_Password_Click">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <TextBlock>
                                <Image x:Name="CheckBoxImage" Source="/Image/Closeeye.png" Width="18" Height="18"/>
                            </TextBlock>
                        </ControlTemplate>
                    </CheckBox.Template>
                    <CheckBox.ToolTip>
                        <ToolTip Background="#90004455">
                            <StackPanel>
                                <TextBlock Margin="3" Foreground="White">Скрыть или отобразить пароль</TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="7" MaxHeight="100">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Right" Margin="20 0 0 0">
                    <TextBlock Width="120" Height="20" TextAlignment="Center">
<Button Width="110" Height="20" Background="#63a4ff" Content="Назад" FontSize="9" FontStyle="Italic"
        x:Name="Button_Back" Foreground="#fff" HorizontalAlignment="Right" Click="Button_Back_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="0 0 20 0">
                    <TextBlock Width="115" Height="20" TextAlignment="Center" HorizontalAlignment="Left">
<Button Width="105" Height="20" Background="#63a4ff" Content="Добавить" FontSize="9" FontStyle="Italic"
        x:Name="Button_AddUser" Foreground="#fff" HorizontalAlignment="Left" Click="Button_AddUser_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
