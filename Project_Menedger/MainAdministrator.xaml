<Window x:Class="Project_Menedger.MainAdministrator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
            Title="Окно администратора" Height="630" Width="800" WindowStartupLocation="CenterScreen" 
Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="630" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition x:Name="VisibleResources"/>
            <RowDefinition x:Name="VisibleUsers"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" MaxHeight="220">
            <Grid>
                <Label Content="Главное меню" FontSize="12" Foreground="White"
                FontStyle="Italic" FontWeight="Black"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="1" MaxHeight="220">
            <Grid>
                <Label Content="Кокорин Дмитрий Сергеевич" FontSize="12" Foreground="White"
                        FontStyle="Italic" FontWeight="Black" x:Name="Label_NameUser"
                       />
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="45" HorizontalAlignment="Right"
 VerticalAlignment="Top">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
                <Button Content="🗕" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 41 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        VerticalContentAlignment="Center" x:Name="Button_RollUp"
        Click="Button_RollUp_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="2" MaxHeight="110" x:Name="InformationProject">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="15" TextAlignment="Center" TextWrapping="Wrap">
                <Button Width="140" Height="15" Background="#63a4ff" Content="Информация о проектах" FontSize="8" FontStyle="Italic"
                        x:Name="Button_Project" Foreground="#fff" Click="Button_Project_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="4" MaxHeight="110" x:Name="InformationUsers">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="15" TextAlignment="Center">
<Button Width="140" Height="15" Background="#63a4ff" Content="Информация о пользователях" FontSize="8" FontStyle="Italic"
        x:Name="Button_User" Foreground="#fff" Click="Button_User_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="3" MaxHeight="110" x:Name="InformationResources">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="16" TextAlignment="Center" TextWrapping="Wrap">
        <Button Width="140" Height="16" Background="#63a4ff" Content="Информация о ресурсах" FontSize="8" FontStyle="Italic"
                x:Name="Button_InfoResource" Foreground="#fff" Click="Button_InfoResource_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="5" MaxHeight="110">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="15" TextAlignment="Center">
<Button Width="140" Height="15" Background="#63a4ff" Content="Новости и мероприятия" FontSize="8" FontStyle="Italic"
        x:Name="Button_NewsAndEvents" Foreground="#fff" Click="Button_NewsAndEvents_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="6" MaxHeight="110">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="15" TextAlignment="Center">
<Button Width="140" Height="15" Background="#63a4ff" Content="Документация" FontSize="8" FontStyle="Italic"
        x:Name="Button_Documents" Foreground="#fff" Click="Button_Documents_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="7" MaxHeight="110" x:Name="Exit">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="200" Height="15" TextAlignment="Center">
<Button Width="140" Height="15" Background="#63a4ff" Content="Выход" FontSize="8" FontStyle="Italic"
        x:Name="Button_Exit" Foreground="#fff" Click="Button_Exit_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
            </StackPanel>
        </Viewbox>
    </Grid>
</Window>
