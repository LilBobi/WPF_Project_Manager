<Window x:Class="Project_Menedger.InformationProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
        Title="Информация о проектах" Height="800" Width="1200" WindowStartupLocation="CenterScreen" 
        Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="800" MinWidth="1200"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.16*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.30*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Row="0" Grid.Column="0" MaxHeight="100">
            <Grid>
                <TextBlock Width="115" Height="20" TextAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="70" Height="20" Background="#63a4ff" Content="Назад" FontSize="9" FontStyle="Italic"
                            x:Name="Button_Back" Foreground="#fff" HorizontalAlignment="Left" Click="Button_Back_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </TextBlock>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Проекты" FontSize="10" Foreground="White"
                        FontStyle="Italic" FontWeight="Black" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Grid.Column="1">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
                <Button Content="🗕" FontFamily="Comic Sans MS" Height="15" Width="15"
        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 41 0"
        FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
        VerticalContentAlignment="Center" x:Name="Button_RollUp"
        Click="Button_RollUp_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationEmployee" Visibility="Visible">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
    <Button Width="110" Height="25" Background="#63a4ff" Content="Просмотреть команду" FontSize="9" FontStyle="Italic"
             Foreground="#fff" HorizontalAlignment="Left" Click="Button_TeamProject_Click">
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Button.Resources>
    </Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" Content="Задачи на проект" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_TasksProject" Click="Button_Tasks_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="2" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic" x:Name="NewsAndEvent"
         Foreground="#fff" HorizontalAlignment="Left" Click="NewsAndEvent_Click">
    <TextBlock Text="Новости и мероприятия" TextWrapping="Wrap"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" Content="Сбросить фильтрацию" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" Click="Button_ClearFilter_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationAdministrator" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
    <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
             Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_TeamProject"
            Click="Button_TeamProject_Click">
        <TextBlock Text="Команда проекта" TextWrapping="Wrap"/>
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Button.Resources>
    </Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" Click="Button_Tasks_Click">
    <TextBlock Text="Задачи проекта" TextWrapping="Wrap"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
                </Grid>
                <Grid Grid.Row="2" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" Content="Добавить проект" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_AddProjectAdministrator" Click="Button_AddProject_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" Click="Button_RedactProject_Click">
                            <TextBlock Text="Редактировать проект" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="4" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" Click="Button_RemoveProject_Click">
                            <TextBlock Text="Удалить проект" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="5" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" Content="Сбросить фильтрацию" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" Click="Button_ClearFilter_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" x:Name="InformationManager" Visibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
    <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
             Foreground="#fff" HorizontalAlignment="Left" Click="Button_TeamProject_Click">
        <TextBlock Text="Команда проекта" TextWrapping="Wrap"/>
        <Button.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </Button.Resources>
    </Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="1" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_Tasks" Click="Button_Tasks_Click">
    <TextBlock Text="Задачи проекта" TextWrapping="Wrap"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                </TextBlock>
                </Grid>
                <Grid Grid.Row="2" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" Content="Добавить проект" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_AddProjecManager" Click="Button_AddProject_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="3" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_RedactProject" Click="Button_RedactProject_Click">
                            <TextBlock Text="Редактировать проект" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="4" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
                        <Button Width="110" Height="25" Background="#63a4ff" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_RemoveProject" Click="Button_RemoveProject_Click">
                            <TextBlock Text="Удалить проект" TextWrapping="Wrap" FontSize="9"/>
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="5" Margin="0 10 0 0" MaxHeight="90">
                    <TextBlock Width="115" Height="25" TextAlignment="Center">
<Button Width="110" Height="25" Background="#63a4ff" Content="Сбросить фильтрацию" FontSize="9" FontStyle="Italic"
         Foreground="#fff" HorizontalAlignment="Left" x:Name="Button_ClearFilter" Click="Button_ClearFilter_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MaxHeight="120">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <Grid>
                        <Label Content="Поиск" FontSize="12" Height="30" Width="90" Foreground="White" 
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               FontStyle="Italic"/>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <Grid>
                        <Label Content="Статус" FontSize="12" Height="30" Width="90" Foreground="White" 
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               FontStyle="Italic"/>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="2">
                    <Grid>
                        <Label Content="Дата начала проекта" FontSize="12" Height="30" Width="140" Foreground="White" 
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               FontStyle="Italic"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" MaxHeight="90">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0">
                    <Grid>
                        <TextBlock Width="120" Height="20" TextAlignment="Center">
                            <TextBox Height="20" Width="110" Foreground="Black" HorizontalContentAlignment="Center"
                            BorderBrush="White" FontSize="9" VerticalContentAlignment="Center" x:Name="TextBox_Search"
                                     TextChanged="TextBox_Search_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        </TextBlock>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="1">
                    <Grid>
                        <TextBlock Width="120" Height="20" TextAlignment="Center">
                            <ComboBox Width="100" FontSize="9" Height="20" x:Name="ComboBox_Category"
                                     SelectedItem="{Binding Statuss}" DisplayMemberPath="Namee" 
                                      SelectedValuePath="Namee" SelectionChanged="ComboBox_Category_SelectionChanged">
                        </ComboBox>
                        </TextBlock>
                    </Grid>
                </Viewbox>
                <Viewbox Grid.Column="2">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="215" Height="25" TextAlignment="Center">
                            <DatePicker Name="datePicker1" IsDropDownOpen="False" SelectedDateFormat="Short" Width="90" Height="25"
                            FontSize="9" SelectedDateChanged="datePicker1_SelectedDateChanged"/>
                            <TextBlock Text="по" FontSize="12" Margin="5 -10 0 0" VerticalAlignment="Center" Height="25" Foreground="White"
                                       TextAlignment="Center"/>
<DatePicker Name="datePicker2" IsDropDownOpen="False" SelectedDateFormat="Short" Width="90" Margin="5 0 0 0" Height="25"
                            FontSize="9" SelectedDateChanged="datePicker2_SelectedDateChanged"/>
                        </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
            </Grid>
            <Viewbox Grid.Row="2" Grid.ColumnSpan="3" Margin="5" Stretch="Fill">
                <ListView Grid.Row="2" Grid.ColumnSpan="3" Margin="5" x:Name="Table"
                          Height="420" Width="900">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="Black">
                                <Grid Width="865">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Название:" Margin="10 7 0 0" FontSize="18"/>
                                            <TextBlock Text="{Binding Namee}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Описание:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Descriptionn}" FontSize="18" Margin="10 7 0 0"
                                           TextWrapping="Wrap" MaxWidth="800"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Дата начала:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Start_Datee, StringFormat=yyyy.MM.dd}" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="Дата окончания:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding End_Datee, StringFormat=yyyy.MM.dd}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Бюджет:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Budget, StringFormat=#.00}" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="рублей" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Статус:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Statuss.Namee}" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="Ресурс:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Resourcee.Namee}" FontSize="18" Margin="10 7 0 7"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Viewbox>
            <Viewbox Grid.Row="2" Grid.ColumnSpan="3" Margin="5" Stretch="Fill">
                <ListView Grid.Row="2" Grid.ColumnSpan="3" Margin="5" x:Name="TableUsers"
              Height="500" Width="900" Visibility="Hidden">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="Black">
                                <Grid Width="865">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Название:" Margin="10 7 0 0" FontSize="18"/>
                                            <TextBlock Text="{Binding Namee}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Описание:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Descriptionn}" FontSize="18" Margin="10 7 0 0"
                               TextWrapping="Wrap" MaxWidth="800"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Дата начала:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding Start_Datee, StringFormat=yyyy.MM.dd}" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="Дата окончания:" FontSize="18" Margin="10 7 0 0"/>
                                            <TextBlock Text="{Binding End_Datee, StringFormat=yyyy.MM.dd}" FontSize="18" Margin="10 7 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Статус:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Statuss.Namee}" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="Ресурс:" FontSize="18" Margin="10 7 0 7"/>
                                            <TextBlock Text="{Binding Resourcee.Namee}" FontSize="18" Margin="10 7 0 7"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
