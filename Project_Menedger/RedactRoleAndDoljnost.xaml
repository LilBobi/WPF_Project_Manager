<Window x:Class="Project_Menedger.RedactRoleAndDoljnost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
                Title="Изменение роли" Height="600" Width="650" WindowStartupLocation="CenterScreen" 
    Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="600" MinWidth="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <Label Content="Редактирование роли" FontSize="12" Foreground="White"
                FontStyle="Italic" FontWeight="Black" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="40" HorizontalAlignment="Right" VerticalAlignment="Top"
         Grid.Column="1">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="1" MaxHeight="110">
            <TextBlock Width="115" Height="15" TextAlignment="Center">
        <TextBlock Width="100" Height="15" Text="Фамилия" FontSize="9" Foreground="White"
                   FontStyle="Italic"/>
    </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="2" MaxHeight="110">
            <TextBlock Width="140" Height="15" TextAlignment="Center">
<TextBox Height="15" Width="115" Foreground="Black" HorizontalContentAlignment="Center"
         BorderBrush="White" FontSize="9" VerticalContentAlignment="Center" x:Name="TextBox_Name"
         IsReadOnly="True">
    <TextBox.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </TextBox.Resources>
</TextBox>
            </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="3" MaxHeight="110">
            <TextBlock Width="115" Height="15" TextAlignment="Center">
        <TextBlock Width="100" Height="15" Text="Имя" FontSize="9" Foreground="White"
                   FontStyle="Italic"/>
    </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="4" MaxHeight="110">
            <TextBlock Width="140" Height="15" TextAlignment="Center">
<TextBox Height="15" Width="115" Foreground="Black" HorizontalContentAlignment="Center"
         BorderBrush="White" FontSize="9" VerticalContentAlignment="Center" x:Name="TextBox_Surname"
         IsReadOnly="True">
    <TextBox.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </TextBox.Resources>
</TextBox>
            </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="5" MaxHeight="110">
            <TextBlock Width="115" Height="15" TextAlignment="Center">
        <TextBlock Width="100" Height="15" Text="Отчество" FontSize="9" Foreground="White"
                   FontStyle="Italic"/>
    </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="6" MaxHeight="110">
            <TextBlock Width="140" Height="15" TextAlignment="Center">
<TextBox Height="15" Width="115" Foreground="Black" HorizontalContentAlignment="Center"
         BorderBrush="White" FontSize="9" VerticalContentAlignment="Center" x:Name="TextBox_Patronomyc"
         IsReadOnly="True">
    <TextBox.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </TextBox.Resources>
</TextBox>
            </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="7" MaxHeight="110">
            <TextBlock Width="115" Height="15" TextAlignment="Center">
            <TextBlock Width="100" Height="15" Text="Должность" FontSize="8" Foreground="White"
                       FontStyle="Italic" TextAlignment="Center"/>
        </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="8" MaxHeight="110">
            <Grid>
                <TextBlock Width="140" Height="15" TextAlignment="Center">
    <ComboBox Width="115" FontSize="8" Height="18" x:Name="ComboBox_Post"
              DisplayMemberPath="Namee" SelectedValuePath="id_Post" SelectionChanged="ComboBox_Post_SelectionChanged">
    </ComboBox>
                </TextBlock>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="9" MaxHeight="110">
            <TextBlock Width="115" Height="15" TextAlignment="Center">
        <TextBlock Width="100" Height="15" Text="Роль" FontSize="8" Foreground="White"
                   FontStyle="Italic" TextAlignment="Center"/>
    </TextBlock>
        </Viewbox>
        <Viewbox Grid.Row="10" MaxHeight="110">
            <Grid>
                <TextBlock Width="140" Height="15" TextAlignment="Center">
          <TextBox Height="15" Width="115" Foreground="Black" HorizontalContentAlignment="Center"
         BorderBrush="White" FontSize="9" VerticalContentAlignment="Center"
         IsReadOnly="True" x:Name="TextBlock_Role"/>
                </TextBlock>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="11" MaxHeight="120">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Right" Margin="20 0 0 0">
                    <TextBlock Width="120" Height="20" TextAlignment="Center">
                    <Button Width="110" Height="20" Background="#63a4ff" Content="Назад" FontSize="9" FontStyle="Italic"
                            x:Name="Button_Back" Foreground="#fff" HorizontalAlignment="Right" Click="Button_Back_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="0 0 20 0">
                    <TextBlock Width="115" Height="20" TextAlignment="Center" HorizontalAlignment="Left">
                    <Button Width="105" Height="20" Background="#63a4ff" Content="Редактировать" FontSize="9" FontStyle="Italic"
                            x:Name="Button_RedactRoleAndDoljnost" Foreground="#fff" HorizontalAlignment="Left"
                            Click="Button_RedactRoleAndDoljnost_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
