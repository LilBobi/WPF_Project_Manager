<Window x:Class="Project_Menedger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_Menedger"
        mc:Ignorable="d"
        Title="Авторизация" Height="400" Width="650" WindowStartupLocation="CenterScreen" 
        Background="#041c36" WindowStyle="None" Icon="/Image/InsiLogo.png" MinHeight="400" MinWidth="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Label Content="Авторизация" FontSize="10" Foreground="White"
                       FontStyle="Italic" FontWeight="Black"/>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="0" MaxHeight="45" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid HorizontalAlignment="Right">
                <Button Content="❌" FontFamily="Comic Sans MS" Height="15" Width="15"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 5 0"
                FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                x:Name="Button_Close" Click="Button_Close_Click"/>
                <Button Content="🔲" FontFamily="Comic Sans MS" Height="15" Width="15"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 23 0"
                FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                x:Name="Button_Unwrap" Click="Button_Unwrap_Click"/>
                <Button Content="🗕" FontFamily="Comic Sans MS" Height="15" Width="15"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 5 41 0"
                FontSize="8" Background="#63a4ff" BorderBrush="#63a4ff"
                VerticalContentAlignment="Center" x:Name="Button_RollUp"
                Click="Button_RollUp_Click"/>
            </Grid>
        </Viewbox>
        <Viewbox Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 40 0"
                        VerticalAlignment="Center">
                <Label Content="Email:" FontSize="12" Height="30" Width="80" Foreground="White" 
                       HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontStyle="Italic"
                       />
                <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center"
                         BorderBrush="White" x:Name="TextBox_Email">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Label Content="Пароль:" FontSize="12" Height="30" Width="80" Foreground="White" 
                       HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                       FontStyle="Italic" Margin="0 0 0 0"/>
                <Grid>
                    <TextBox Height="17" Width="120" Foreground="Black" HorizontalContentAlignment="Center" x:Name="TextBox_Password"
                             Margin="0 0 0 0" BorderBrush="White">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <PasswordBox Height="22" Width="125" HorizontalAlignment="Center" VerticalAlignment="Center" 
             VerticalContentAlignment="Center" x:Name="PasswordBox_Password" HorizontalContentAlignment="Center"
             Margin="0 0 0 0">
                        <PasswordBox.Resources>
                            <Style TargetType="{x:Type PasswordBox}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type PasswordBox}">
                                            <Border CornerRadius="13" BorderThickness="2" Background="White">
                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </Grid>
                <CheckBox Height="15" Margin="0 0 20 0" x:Name="CheckBox_Password"
                          Click="CheckBox_Password_Click">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <TextBlock>
                                <Image x:Name="CheckBoxImage" Source="/Image/Closeeye.png" Width="18" Height="18"/>
                            </TextBlock>
                        </ControlTemplate>
                    </CheckBox.Template>
                    <CheckBox.ToolTip>
                        <ToolTip Background="#90004455">
                            <StackPanel>
                                <TextBlock Margin="3" Foreground="White">Скрыть или отобразить пароль</TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </CheckBox.ToolTip>
                </CheckBox>
            </StackPanel>
        </Viewbox>
        <Viewbox Grid.Row="3" MaxHeight="110">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Right" Margin="20 0 0 0">
                    <TextBlock Width="120" Height="20" TextAlignment="Center">
<Button Width="110" Height="20" Background="#63a4ff" Content="Выход из программы" FontSize="9" FontStyle="Italic"
        x:Name="Button_Registration" Foreground="#fff" HorizontalAlignment="Right" Click="Button_Registration_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
                <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="0 0 20 0">
                    <TextBlock Width="110" Height="20" TextAlignment="Center" HorizontalAlignment="Left">
<Button Width="100" Height="20" Background="#63a4ff" Content="Войти" FontSize="9" FontStyle="Italic"
        x:Name="Button_Input" Foreground="#fff" HorizontalAlignment="Left" Click="Button_Input_Click">
    <Button.Resources>
        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Button.Resources>
</Button>
                    </TextBlock>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
